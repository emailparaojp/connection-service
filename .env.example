# ==============================================================
# CONNECTION-SERVICE — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores
# NUNCA versione o arquivo .env com valores reais
# ==============================================================

# --------------------------------------------------------------
# Criptografia
# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# --------------------------------------------------------------
FERNET_KEY=

# --------------------------------------------------------------
# Banco de Dados de Auditoria (SQLite)
# --------------------------------------------------------------
SQLITE_DATABASE_URL=sqlite:///./audit.db

# --------------------------------------------------------------
# Robôs registrados (nomes separados por vírgula)
# O nome deve corresponder ao prefixo das variáveis abaixo
# --------------------------------------------------------------
ROBOTS=robo-financeiro,robo-fiscal,robo-rh,backend

# --------------------------------------------------------------
# API Keys dos Robôs
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
# --------------------------------------------------------------
ROBO_FINANCEIRO_API_KEY=
ROBO_FISCAL_API_KEY=
ROBO_RH_API_KEY=
BACKEND_API_KEY=

# --------------------------------------------------------------
# Ambientes permitidos por robô (DEV, HOM, PROD)
# --------------------------------------------------------------
ROBO_FINANCEIRO_ALLOWED_ENVS=DEV,HOM
ROBO_FISCAL_ALLOWED_ENVS=DEV,HOM,PROD
ROBO_RH_ALLOWED_ENVS=DEV
BACKEND_ALLOWED_ENVS=DEV

# --------------------------------------------------------------
# Oracle — Variáveis GLOBAIS (fallback para sistemas sem config própria)
# Usadas quando não há variável específica {SISTEMA}_{AMBIENTE}_{CAMPO}
# --------------------------------------------------------------
DB_DEV_HOST=
DB_DEV_PORT=1521
DB_DEV_SERVICE_NAME=
DB_DEV_USER=
DB_DEV_PASSWORD=

# --------------------------------------------------------------
# Oracle — Ambiente HOM
# --------------------------------------------------------------
DB_HOM_HOST=
DB_HOM_PORT=1521
DB_HOM_SERVICE_NAME=
DB_HOM_USER=
DB_HOM_PASSWORD=

# --------------------------------------------------------------
# Oracle — Ambiente PROD
# --------------------------------------------------------------
DB_PROD_HOST=
DB_PROD_PORT=1521
DB_PROD_SERVICE_NAME=
DB_PROD_USER=
DB_PROD_PASSWORD=

# --------------------------------------------------------------
# Oracle — Variáveis ESPECÍFICAS por sistema (sobrepõem as globais)
# Padrão: {SISTEMA}_{AMBIENTE}_{CAMPO}
#
# Campos disponíveis: HOST, PORT, SERVICE_NAME, USER, PASSWORD, SCHEMA
# SCHEMA é opcional — sistemas sem SCHEMA receberão o campo como string vazia.
#
# Exemplos:
# AGUIA_DEV_HOST=oracle-aguia-dev.internal
# AGUIA_DEV_PORT=1521
# AGUIA_DEV_SERVICE_NAME=AGUIADB
# AGUIA_DEV_USER=aguia_user
# AGUIA_DEV_PASSWORD=aguia_pass
# AGUIA_DEV_SCHEMA=SCH_AGUIA
#
# ROBO_FINANCEIRO_DEV_HOST=oracle-fin-dev.internal
# ROBO_FINANCEIRO_DEV_SERVICE_NAME=FINDB
# ROBO_FINANCEIRO_DEV_USER=fin_user
# ROBO_FINANCEIRO_DEV_PASSWORD=fin_pass
# --------------------------------------------------------------

# --------------------------------------------------------------
# Rate Limiting
# --------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=20

# --------------------------------------------------------------
# Logging
# --------------------------------------------------------------
LOG_LEVEL=INFO
